# Copy to .env and adjust. Do not commit secrets.

# Postgres (docker-compose)
POSTGRES_USER=kathapp
POSTGRES_PASSWORD=kathapp
POSTGRES_DB=kathapp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kathapp:kathapp@localhost:5432/kathapp?schema=public

# Optional Redis (docker compose --profile redis up -d)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
PORT=3000
# Marks this as a local development environment. Required for the API to
# accept the placeholder JWT_SECRET below; anywhere else it refuses to start.
NODE_ENV=development

# Local placeholder only. Any other environment must set a real secret — the
# API will not fall back to a built-in value.
JWT_SECRET=dev-change-me
JWT_EXPIRES_IN=7d

# POST /v1/auth/dev-login mints a token for any email address, including an
# admin one. It is OFF unless this is exactly "true". Never set it in a
# deployment that is reachable by anyone else.
AUTH_DEV_LOGIN=true

# Web (Vite)
VITE_API_URL=http://localhost:3000

# Integration tests (separate Postgres schema, never your working data)
TEST_DATABASE_URL=postgresql://kathapp:kathapp@localhost:5432/kathapp?schema=test
