// KathApp API — Contract-v1 Prisma schema
// Soft delete via deletedAt; updatedAt on all domain entities.
// No invented saints/miracles content — schema only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  contributor
  reviewer
  admin
}

enum PublishStatus {
  draft
  published
}

enum SuggestionStatus {
  submitted
  in_review
  accepted
  rejected
}

enum EntityType {
  saint
  miracle
  source
  citation
  edge
  translation
  suggestion
}

/// Contract-v1 edge kinds. fromId/toId follow type-name order
/// (saint_miracle → fromId=Saint, toId=Miracle).
enum EdgeType {
  saint_miracle
  miracle_source
  saint_source
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  displayName String?
  role        Role      @default(viewer)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  suggestionsSubmitted Suggestion[] @relation("SuggestionSubmitter")
  suggestionsReviewed  Suggestion[] @relation("SuggestionReviewer")
}

model Saint {
  id              String        @id @default(cuid())
  status          PublishStatus @default(draft)
  slug            String?       @unique
  feastNote       String?
  deathYear       Int?
  deathYearApprox Boolean?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
}

model Miracle {
  id         String        @id @default(cuid())
  status     PublishStatus @default(draft)
  approxDate String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
}

model Source {
  id        String        @id @default(cuid())
  status    PublishStatus @default(draft)
  language  String
  author    String?
  year      Int?
  shelfmark String?
  url       String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  citations Citation[]
}

model Citation {
  id           String      @id @default(cuid())
  sourceId     String
  source       Source      @relation(fields: [sourceId], references: [id])
  locus        String
  excerpt      String?
  excerptLatin String?
  entityType   EntityType?
  entityId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  edges Edge[]

  @@index([sourceId])
  @@index([entityType, entityId])
}

model Edge {
  id         String    @id @default(cuid())
  type       EdgeType
  fromId     String
  toId       String
  citationId String?
  citation   Citation? @relation(fields: [citationId], references: [id])
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([fromId])
  @@index([toId])
  @@index([type])
  @@index([citationId])
}

model Translation {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  locale     String
  field      String
  value      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  @@unique([entityType, entityId, locale, field])
  @@index([locale])
}

model Suggestion {
  id                String           @id @default(cuid())
  entityType        EntityType
  entityId          String?
  status            SuggestionStatus @default(submitted)
  schemaVersion     Int              @default(1)
  payload           Json
  submittedByUserId String
  submittedBy       User             @relation("SuggestionSubmitter", fields: [submittedByUserId], references: [id])
  reviewedByUserId  String?
  reviewedBy        User?            @relation("SuggestionReviewer", fields: [reviewedByUserId], references: [id])
  reviewNote        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@index([status])
  @@index([entityType, entityId])
}
